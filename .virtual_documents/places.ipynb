import pandas as pd
import joblib

from sklearn.preprocessing import OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.neighbors import NearestNeighbors


import pandas as pd

df = pd.read_csv("clean_places.csv")


df = df[[
    "Name",
    "State",
    "City",
    "Type",
    "Google review rating",
    "Entrance Fee in INR",
    "DSLR Allowed",
    "Best Time to visit"
]]


df.fillna("Unknown", inplace=True)

# Convert fee to numeric
df["Entrance Fee in INR"] = pd.to_numeric(
    df["Entrance Fee in INR"],
    errors="coerce"
).fillna(0)


df["Google review rating"] = pd.to_numeric(
    df["Google review rating"],
    errors="coerce"
).fillna(df["Google review rating"].median())


features = [
    "State",
    "City",
    "Type",
    "Google review rating",
    "Entrance Fee in INR",
    "DSLR Allowed",
    "Best Time to visit"
]

X = df[features]


categorical = [
    "State",
    "City",
    "Type",
    "DSLR Allowed",
    "Best Time to visit"
]

numeric = [
    "Google review rating",
    "Entrance Fee in INR"
]

encoder = ColumnTransformer(
    transformers=[
        ("cat", OneHotEncoder(handle_unknown="ignore"), categorical)
    ],
    remainder="passthrough"
)

X_encoded = encoder.fit_transform(X)


model = NearestNeighbors(
    n_neighbors=10,
    metric="cosine"
)

model.fit(X_encoded)


joblib.dump(model, "recommendation_model.pkl")
joblib.dump(encoder, "encoder.pkl")
joblib.dump(df, "places_data.pkl")

print("Model Saved Successfully")






